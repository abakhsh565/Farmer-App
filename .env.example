[TEMPLATE]
# Client configuration — copy to `.env.local` and fill in.
#
# READ THIS FIRST.
#
# Every value here is inlined into the JavaScript bundle by Vite and therefore
# shipped inside the APK, where anyone can read it. So a value only belongs here
# if it is safe to publish on a billboard.
#
#   · Safe: the Supabase URL, the Supabase anon (publishable) key, the PostHog
#     project key, and the URLs of our own Edge Functions.
#   · NOT safe, ever: the Supabase service_role key, the OpenAI key, the SMS
#     provider's tokens, the FCM service account, AMIS credentials, the dealer
#     system's token or connection string.
#
# Those belong to the server. They go in the Supabase dashboard under
# Edge Functions → Secrets, and the functions read them with Deno.env.get().
# A key in this file is a key published on the internet.
#
# After changing anything here, rebuild: Vite bakes the values in at build time.
#   npm run build && npm run apk

# ── Backend ────────────────────────────────────────────────────────────────
# Setting BOTH of these switches persistence, market and `auto` weather from the
# development providers to the real backend. The anon key is designed to be
# public; row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Weather ────────────────────────────────────────────────────────────────
# auto (default) | supabase | open-meteo | development
# `open-meteo` calls the vendor directly from the app. It is keyless, so it is
# how live weather arrives before the backend exists. `auto` reads the
# normalised table when a backend is configured, and the fixture otherwise —
# an unconfigured build never makes a network call.
VITE_WEATHER_PROVIDER=open-meteo

# ── Our own Edge Function endpoints ────────────────────────────────────────
# These are our server, not a vendor: the key stays inside the function.
# The app appends its route (`/ask`, `/request`) to the function URL.
# AI gateway (scan diagnosis + the assistant).
VITE_AI_ENDPOINT=
# Verification: send and check a one-time code.
VITE_OTP_ENDPOINT=
# Weather ingestion: fills `weather_readings` so the UI and the AI read the same
# reading instead of making two independent vendor calls.
VITE_WEATHER_INGEST_ENDPOINT=
# Dealer projection, when the app reads it through our own endpoint instead of
# the Supabase RPCs.
VITE_DEALER_ENDPOINT=

# ── Analytics ──────────────────────────────────────────────────────────────
# PostHog project keys are write-only and public by design.
VITE_ANALYTICS_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Demo sign-in (DEVELOPMENT ONLY — never set this in production) ─────────
# Two fixed identities for walking the product end to end when no code can be
# delivered. With Twilio's credentials rejected (error 20003) there is no way to
# receive an SMS, and a code that never arrives cannot produce the one thing the
# app actually needs: a real Supabase session, because every row-level policy
# matches on `auth.uid()`.
#
# This is not a bypass. It signs in with `signInWithPassword` to accounts that
# already exist, so Supabase issues a genuine token and every policy applies
# exactly as it does for a production farmer. Only the code is fixed, and only
# it is shown on screen instead of being sent.
#
# Read behind `import.meta.env.DEV`, so it is compiled out of every `vite build`
# and a production bundle cannot select the demo provider. Keep it in
# `.env.local`, which is git-ignored — and never in a hosting provider's
# environment for a production deployment.
#
# Shape: a JSON array, or { "identities": [ ... ] }.
#   destination  must match the app's own validation — a Pakistani mobile as
#                03XXXXXXXXX, or an email address
#   code         the six digits shown on the sheet, and the account's password,
#                so the two must agree (see the account setup below)
#   channel      "phone" or "email"
#
# The accounts are created ONCE, and never by the app — the app not creating them
# is what stops "any code creates an account". Provision them from this same
# variable, so the sheet and the accounts cannot disagree:
#
#   SUPABASE_SERVICE_ROLE_KEY=<Project Settings → API → service_role> npm run provision:demo
#
# That is the same request the dashboard makes (Authentication → Users → Add
# user), and it is idempotent: a destination that already exists keeps its id,
# its party and its data, and only has its password and confirmation reset. The
# key is an admin credential and is never committed or printed; the script says
# what to do when it is missing. It needs Node 22.18+ — it runs TypeScript
# directly, which is how it reads this very variable through the app's own parser.
#
# Both channels work: the script confirms the email *and* the phone, which is what
# password sign-in by phone requires. One caveat for a phone identity — the
# sign-in itself needs no SMS provider (nothing is sent), but the project's phone
# provider has to be enabled for Supabase to accept a phone identifier at all.
#
# Example (two identities, two codes — they must differ; either channel works, and
# one of each proves both):
# VITE_DEMO_FARMERS=[{"name":"Demo Farmer A","channel":"phone","destination":"03000000001","code":"111111"},{"name":"Demo Farmer B","channel":"email","destination":"demo.b@example.com","code":"222222"}]
VITE_DEMO_FARMERS=
