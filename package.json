{
  "name": "farmer-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Punjab farmer app. Colours and typefaces carried over from the archived design system; UI built with shadcn + Tailwind.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-design.mjs",
    "lint:migrations": "node scripts/check-migrations.mjs",
    "lint:functions": "node scripts/check-functions.mjs",
    "check:ingestion-lifecycle": "vitest run src/intelligence/ingestionLifecycle.contract.test.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/App*.test.tsx\" --passWithNoTests",
    "test:app": "vitest run src/App --passWithNoTests",
    "check:fast": "npm run typecheck && npm run lint && npm run test:unit",
    "cap:sync": "npm run build && cap sync android",
    "apk": "npm run cap:sync && node scripts/build-apk.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "provision:demo": "node --disable-warning=ExperimentalWarning scripts/provision-demo-farmers.ts",
    "import:advisories": "node scripts/import-advisories.mjs",
    "import:market": "node scripts/import-market.mjs",
    "verify:isolation": "bash scripts/verify-isolation.sh",
    "verify:ai-controls": "bash scripts/verify-ai-controls.sh",
    "verify:recovery": "bash scripts/verify-recovery.sh",
    "verify:performance": "bash scripts/verify-performance.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "onnxruntime-web": "^1.30.0",
    "posthog-js": "^1.435.8",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
